# Sanity CMS
# Project ID from https://manage.sanity.io (e.g. abc12345)
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset name (e.g. production)
NEXT_PUBLIC_SANITY_DATASET=production
# GROQ API version, format YYYY-MM-DD (defaults to 2024-01-01 if unset)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# API token with read access for the frontend; write access if publishing via API
SANITY_API_TOKEN=

# Email service (contact form delivery)
# Provider API key, e.g. Resend: https://resend.com/api-keys
EMAIL_SERVICE_API_KEY=
# Sender address (Resend defaults to onboarding@resend.dev when unset)
CONTACT_FROM_EMAIL=
# Recipient inbox that receives contact form submissions
CONTACT_TO_EMAIL=

# Revalidation webhook secret (Sanity webhook -> /api/revalidate)
REVALIDATE_SECRET=

# Site URL used for sitemap/canonical URLs (e.g. https://example.com)
NEXT_PUBLIC_SITE_URL=